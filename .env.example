# EIGHT CREATORS LABs — Variables de Entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio.

# Supabase — obtén estos valores en:
#   Supabase Dashboard → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

# IMPORTANTE: La service_role key NUNCA debe usarse en el frontend.
# Solo úsala en Edge Functions o servicios backend.
# SUPABASE_SERVICE_ROLE_KEY=nunca_en_el_frontend
